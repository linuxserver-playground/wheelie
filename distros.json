{
  "_comment": "One entry per base image the wheels are built on, oldest first within an index (the first build of a shared filename wins). python, libc and libc_version are read from the image (python3 -V, apk list -I musl, ldd --version) and only change when the base image moves to a new release; the gap check reads them from here so it never starts a container.",
  "distros": {
    "alpine-3.21": {
      "image": "ghcr.io/linuxserver-playground/baseimage-alpine:3.21",
      "index": "alpine-3.21",
      "python": "3.12",
      "libc": "musl",
      "libc_version": "1.2"
    },
    "alpine-3.22": {
      "image": "ghcr.io/linuxserver-playground/baseimage-alpine:3.22",
      "index": "alpine-3.22",
      "python": "3.12",
      "libc": "musl",
      "libc_version": "1.2"
    },
    "alpine-3.23": {
      "image": "ghcr.io/linuxserver-playground/baseimage-alpine:3.23",
      "index": "alpine-3.23",
      "python": "3.12",
      "libc": "musl",
      "libc_version": "1.2"
    },
    "alpine-3.24": {
      "image": "ghcr.io/linuxserver-playground/baseimage-alpine:3.24",
      "index": "alpine-3.24",
      "python": "3.14",
      "libc": "musl",
